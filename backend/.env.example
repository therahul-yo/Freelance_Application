NODE_ENV=development
PORT=5001

MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/smithworks

JWT_SECRET=your_jwt_secret_here

# Primary frontend URL (dev default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

